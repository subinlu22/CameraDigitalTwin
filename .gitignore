# ===== Unity 자동 생성 폴더 (컴퓨터마다 새로 만들어지는 캐시) =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# ===== 빌드 결과물 =====
*.apk
*.aab
*.unitypackage

# ===== Visual Studio / Rider 등 IDE 생성 파일 =====
/.vs/
/.vscode/
/.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ===== OS 잡파일 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 주의: *.meta 는 절대 넣지 말 것 (임포트 설정이 들어있음) =====
*.slnx

# ===== MCP for Unity (에디터 전용 도구, 로컬 임베디드 패키지) =====
/Packages/com.coplaydev.unity-mcp/

# ===== 스튜디오 렌더 결과물 (Tools > 스튜디오 렌더) - 용량 커서 레포에 안 넣음 =====
/Renders/

# 파이썬 임시 파일
__pycache__/

# ===== Poly Haven 원본 에셋 (Tools/fetch_polyhaven.py로 받음) =====
# .meta는 커밋 → 다시 받아도 머티리얼 연결(GUID) 유지
/Assets/ThirdParty/PolyHaven/**/*.jpg
/Assets/ThirdParty/PolyHaven/**/*.hdr
/Assets/ThirdParty/PolyHaven/**/*.fbx

# ===== Unity Factory (에셋 스토어, 재배포 금지) — Tools/import_unity_factory.py로 넣음 =====
/Assets/ThirdParty/UnityFactory/
/Assets/ThirdParty/UnityFactory.meta

# ===== 라이트맵 (용량 큼, 다른 PC에선 Lighting 창에서 Generate 한 번) =====
/Assets/Scenes/SampleScene/Lightmap-*
